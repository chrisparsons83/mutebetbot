# Discord application (Developer Portal → your app)
# Bot → Reset Token. Secret: never commit.
DISCORD_TOKEN=
# General Information → Application ID
DISCORD_CLIENT_ID=
# Dev only: register commands to this one server (instant). Leave empty to register globally.
DISCORD_DEV_GUILD_ID=

# Postgres. compose.yaml publishes the dev database on POSTGRES_PORT.
POSTGRES_USER=mutebet
POSTGRES_PASSWORD=mutebet
POSTGRES_DB=mutebet
POSTGRES_PORT=5437
DATABASE_URL=postgres://mutebet:mutebet@localhost:5437/mutebet

# Website base URL (used for canonical links and Developer Portal URLs)
PUBLIC_BASE_URL=https://mutebetbot.flexspotff.com

# Bot runtime (optional)
HEALTH_PORT=8080
LOG_LEVEL=info
NODE_ENV=development
