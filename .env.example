# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose) ---
POSTGRES_USER=mutebetbot
POSTGRES_PASSWORD=mutebetbot
POSTGRES_DB=mutebetbot
POSTGRES_PORT=5432

# --- Shared ---
DATABASE_URL=postgres://mutebetbot:mutebetbot@localhost:5432/mutebetbot

# --- Bot ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Set in development to register slash commands to one guild instantly.
DISCORD_DEV_GUILD_ID=
NODE_ENV=development
LOG_LEVEL=info
HEALTH_PORT=8080
