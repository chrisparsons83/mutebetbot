{
  // Source runs directly on Node 24 via native type stripping, so tsc only
  // typechecks: no emit, erasable syntax only, and explicit .ts imports.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["apps/bot/src", "apps/bot/scripts", "packages/*/src", "packages/*/drizzle.config.ts", "vitest.config.ts", "eslint.config.js"]
}
